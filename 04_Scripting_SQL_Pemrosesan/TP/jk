-- =========================================
-- NOMOR 2
-- MENAMPILKAN HARGA TEATER
-- SETELAH DISKON 15%
-- =========================================

SELECT
    ID_THEATER,
    KELAS,
    HARGA AS HARGA_AWAL,
    HARGA - (HARGA * 0.15) AS HARGA_SETELAH_DISKON
FROM THEATER_103122400060;

-- =========================================
-- NOMOR 3
-- MENAMPILKAN TOTAL PEMASUKAN
-- MASING-MASING TEATER
-- =========================================

nomor 1

SELECT
    F.JUDUL,
    J.ID_THEATER,
    TO_CHAR(J.PERIODE_START,'DD-MM-YYYY') AS TANGGAL_MULAI,
    EXTRACT(DAY FROM J.PERIODE_END) AS LAMA_TAYANG
FROM FILM_103122400060 F
JOIN JADWAL_103122400060 J
ON F.ID_FILM = J.ID_FILM
WHERE F.JUDUL = 'Habibie Ainun 3';

nomor 2

SELECT
    T.ID_THEATER,
    F.JUDUL,
    T.KELAS,
    T.HARGA,
    CASE
        WHEN T.HARGA = 30000 THEN 'Murah'
        WHEN T.HARGA = 100000 THEN 'Mahal'
        ELSE 'Normal'
    END AS KATEGORI
FROM THEATER_103122400060 T
JOIN JADWAL_103122400060 J
ON T.ID_THEATER = J.ID_THEATER
JOIN FILM_103122400060 F
ON J.ID_FILM = F.ID_FILM
ORDER BY T.ID_THEATER;

nomor 3
SELECT
    M.ID_MEMBER,
    T.HARGA AS HARGA_AWAL,
    FLOOR(MONTHS_BETWEEN(SYSDATE,M.TGL_LAHIR)/12) AS UMUR,
    CASE
        WHEN FLOOR(MONTHS_BETWEEN(SYSDATE,M.TGL_LAHIR)/12) <= 32
        THEN T.HARGA - (T.HARGA * 0.10)
        ELSE T.HARGA
    END AS HARGA_DISKON
FROM MEMBER_103122400060 M
JOIN TRANSAKSI_103122400060 TR
ON M.ID_MEMBER = TR.ID_MEMBER
JOIN JADWAL_103122400060 J
ON TR.ID_JADWAL = J.ID_JADWAL
JOIN THEATER_103122400060 T
ON J.ID_THEATER = T.ID_THEATER
ORDER BY UMUR;

nomor 4
SELECT
    M.ID_MEMBER,
    M.NAMA,
    F.JUDUL
FROM MEMBER_103122400060 M
JOIN TRANSAKSI_103122400060 TR
ON M.ID_MEMBER = TR.ID_MEMBER
JOIN JADWAL_103122400060 J
ON TR.ID_JADWAL = J.ID_JADWAL
JOIN FILM_103122400060 F
ON J.ID_FILM = F.ID_FILM
WHERE F.DURASI >= 100
AND TO_NUMBER(SUBSTR(M.NO_HP,-1,1)) = 8;

nomor 5
SELECT
    M.ID_MEMBER,
    F.ID_FILM,
    T.ID_THEATER,
    T.HARGA AS HARGA_ASLI,
    T.HARGA - (T.HARGA * 0.70) AS HARGA_DISKON
FROM MEMBER_103122400060 M
JOIN TRANSAKSI_103122400060 TR
ON M.ID_MEMBER = TR.ID_MEMBER
JOIN JADWAL_103122400060 J
ON TR.ID_JADWAL = J.ID_JADWAL
JOIN FILM_103122400060 F
ON J.ID_FILM = F.ID_FILM
JOIN THEATER_103122400060 T
ON J.ID_THEATER = T.ID_THEATER
WHERE F.JUDUL = 'Keluarga Cemara';

BEGIN EXECUTE IMMEDIATE 'DROP TABLE KURSI CASCADE CONSTRAINTS'; EXCEPTION WHEN OTHERS THEN NULL; END;
/
BEGIN EXECUTE IMMEDIATE 'DROP TABLE TEATER CASCADE CONSTRAINTS'; EXCEPTION WHEN OTHERS THEN NULL; END;
/

create table TEATER (
    nomor_teater VARCHAR2(20) PRIMARY KEY
);

create table KURSI (
    id_kursi VARCHAR2(20) PRIMARY KEY,
    nomor_teater VARCHAR2(20),
    nomor_kursi VARCHAR2(5)
);

BEGIN
  for t in 1..5 loop
    insert into TEATER VALUES ('Teater ' || t);
    
    for k in 1..40 loop
      insert into KURSI VALUES (
        'K_' || t || '_' || k, 
        'Teater ' || t, 
        CHR(64+t) || k
      );
    end loop;
  end loop;
  commit;
end;
/

select 
    TEATER.nomor_teater AS NOMOR_TEATER, 
    KURSI.nomor_kursi AS NO_K
from 
    TEATER
JOIN 
    KURSI on TEATER.nomor_teater = KURSI.nomor_teater
ORDER by 
    TEATER.nomor_teater, 
    KURSI.nomor_kursi;
    
